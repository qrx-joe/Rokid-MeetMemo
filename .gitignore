# Dependencies (not used yet, but reserved)
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
*.tsbuildinfo

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Local env / secrets
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
