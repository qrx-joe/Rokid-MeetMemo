# Temp / cache
.cache/
.tmp/
tmp/

# Reference dumps: large vendor bundles we don't author
# Keep these in reference/ for documentation lookup only; not part of the project.
# Comment the next 3 lines if you want them tracked.
reference/*.js
reference/*.bundle.js
reference/rokid_*.html

# Python venv (in case a tool drops one here)
.venv/
__pycache__/
*.pyc
